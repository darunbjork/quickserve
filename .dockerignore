# Dependencies (reinstalled inside the container anyway)
node_modules
npm-debug.log

# Environment / secrets — never bake these into an image
.env
.env.*
!.env.example

# Version control
.git
.gitignore

# Editor/OS junk
.vscode
.idea
.DS_Store

# Build output that gets regenerated
dist
build
coverage

# Docker-related files that don't need to be in the image
Dockerfile
docker-compose.yml
.dockerignore

# Tests and docs (optional — depends if you need them at runtime)
tests
*.test.ts
README.md

# Logs
*.log
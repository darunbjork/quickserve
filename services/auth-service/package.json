    "argon2": "^0.45.1",
    "express": "^4.18.2",
    "jose": "^5.10.0",
    "oidc-provider": "^8.4.3",
    "pino-http": "^8.6.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@prisma/config": "^7.9.1",
    "@types/express": "^4.17.25",
    "@types/node": "^20.11.0",
    "@types/oidc-provider": "^9.11.1",
    "prisma": "^7.9.1",

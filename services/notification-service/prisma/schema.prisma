generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma-client"
}

datasource db {
  provider = "postgresql"
}

model Notification {
  id         String   @id @default(uuid())
  orderId    String
  customerId String
  type       String
  message    String
  createdAt  DateTime @default(now())

  @@unique([orderId, type])
  @@index([customerId])
  @@map("notifications")
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma-client"
}

datasource db {
  provider = "postgresql"
}

model MenuItem {
  id          String   @id @default(uuid())
  sku         String   @unique
  name        String
  description String
  basePrice   Int
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isAvailable])
  @@map("menu_items")
}
